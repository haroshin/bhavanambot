# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# (Optional) Specific Chat ID to restrict bot or target scheduled messages to
# E.g. -1001234567890 for a Telegram group
TARGET_CHAT_ID=

# (Optional) Enable/Disable automated scheduled reminders (true/false)
ENABLE_SCHEDULED_REMINDERS=false

# Cron expression for automated reminders (Default: Every Tuesday & Friday at 20:00 / 8:00 PM)
# Format: sec min hour day-of-month month day-of-week
# '0 20 * * 2,5' = Tuesday and Friday at 8:00 PM
TRASH_SCHEDULE_CRON=0 20 * * 2,5
